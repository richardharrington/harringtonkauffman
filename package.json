{
  "name": "harrington-kauffman-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static site for Harrington & Kauffman",
  "scripts": {
    "clean": "rm -rf _site .cache/generated .cache/images.json",
    "images": "node scripts/generate-images.js",
    "dev": "npm run images && eleventy --serve",
    "build": "npm run images && eleventy",
    "check:links": "node scripts/check-links.js",
    "validate:html": "html-validate '_site/**/*.html'",
    "format:css": "prettier --write 'src/**/*.css' 'diary/style.css'",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm run test && npm run check:links && npm run validate:html"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "html-validate": "^10.17.0",
    "js-yaml": "^5.2.2",
    "markdown-it": "^14.3.0",
    "prettier": "^3.9.6",
    "sharp": "0.35.3"
  },
  "overrides": {
    "@11ty/recursive-copy": "5.0.2"
  }
}

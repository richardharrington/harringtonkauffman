<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title }} · {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/generated/social-default.jpg' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ bodyClass or '' }}">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <div class="header-inner">
      <a class="masthead" href="/" aria-label="Harrington & Kauffman, home">Harrington <span>&amp;</span> Kauffman</a>
      <nav class="primary-nav" aria-label="Primary navigation">
        <a href="/shows/"{% if page.url == '/shows/' %} aria-current="page"{% endif %}>Shows</a>
        <a href="/performance-history/"{% if page.url == '/performance-history/' %} aria-current="page"{% endif %}>Performance History</a>
        <a href="/about/"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
        <a href="/press/"{% if page.url == '/press/' or page.url == '/press/image-archive/' %} aria-current="page"{% endif %}>Press &amp; Contact</a>
      </nav>
    </div>
  </header>
  <main id="main-content">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="footer-inner">
      <nav class="footer-archive" aria-label="Archive">
        <p class="footer-heading">Archive</p>
        <p><a href="/diary/">Gustave and Nhar’s Diary</a> <span aria-hidden="true">•</span> <a href="/press/image-archive/">Image Archive</a></p>
      </nav>
      <nav aria-label="Social links"><ul class="social-links">
        {% for social in site.social %}
          <li>{% if social.url %}<a href="{{ social.url }}" rel="noopener noreferrer">{{ social.label }}</a>{% else %}<span>{{ social.label }}</span>{% endif %}</li>
        {% endfor %}
      </ul></nav>
      <div class="footer-meta"><p><a href="/press/#contact">Contact</a></p><p class="copyright">© {{ buildYear }} Harrington &amp; Kauffman</p></div>
    </div>
  </footer>
  {% if loadVideos %}<script type="module" src="/assets/js/video-facades.js"></script>{% endif %}
  {% if loadEngagements %}<script type="module" src="/assets/js/engagements.js"></script>{% endif %}
</body>
</html>

<div class="video-shell">
  <button class="video-facade" type="button" data-video-facade data-video-src="{{ video.embedUrl }}" data-video-provider="{{ video.provider | lower }}" data-video-title="{{ video.title }}">
    <span class="video-play" aria-hidden="true">▶</span>
    <span><strong>Play video</strong><small>{{ video.title }} · loads {{ video.provider | capitalize }}</small></span>
  </button>
</div>

---
layout: layouts/base.njk
permalink: /performance-history/index.html
title: Selected Performance History
description: A selected chronological ledger of Harrington & Kauffman performances.
---
<div class="page">
  <header class="page-intro"><p class="eyebrow">On the road</p><h1>Selected Performance History</h1><p class="prose">This ledger gathers every engagement that could be placed reliably from the surviving site, diaries, and review record. It remains selected because some dates and venues have not yet been recovered. Solo projects are not included.</p></header>
  <nav aria-label="Jump by decade"><ul class="ledger-nav"><li><a href="#2020s">2020s</a></li><li><a href="#2010s">2010s</a></li><li><a href="#2000s">2000s</a></li><li><a href="#1990s">1990s</a></li><li><a href="#undated">Dates to recover</a></li></ul></nav>
  {% set currentYear = '' %}
  {% set anchors = { 'Motel California': false, 'Nharcolepsy': false, 'Cabaret Terrarium': false } %}
  {% for entry in performanceHistory.entries %}
    {% if entry.year != currentYear %}{% if not loop.first %}</ol>{% endif %}<h2 class="ledger-year" id="{% if entry.decade != performanceHistory.entries[loop.index0 - 1].decade or loop.first %}{{ entry.decade }}{% else %}year-{{ entry.year | lower | replace(' ', '-') }}{% endif %}">{{ entry.year }}</h2><ol class="ledger">{% set currentYear = entry.year %}{% endif %}
      <li id="{{ entry.id }}"{% if entry.production == 'Motel California' %} data-production="motel-california"{% elseif entry.production == 'Nharcolepsy' %} data-production="nharcolepsy"{% elseif entry.production == 'Cabaret Terrarium' %} data-production="cabaret-terrarium"{% endif %}>{% if entry.id == 'indy-fringe-2019' %}<span class="legacy-anchor" id="nharcolepsy-entries" aria-hidden="true"></span>{% elseif entry.id == 'winnipeg-2010' %}<span class="legacy-anchor" id="cabaret-terrarium-entries" aria-hidden="true"></span>{% elseif entry.id == 'orlando-2002' %}<span class="legacy-anchor" id="motel-california-entries" aria-hidden="true"></span>{% endif %}
        <div class="ledger-date">{{ entry.date }}</div>
        <div><a class="ledger-production" href="/shows/{% if entry.showAnchor != 'shows' %}#{{ entry.showAnchor }}{% endif %}">{{ entry.production }}</a>{% if entry.presenter %}<br>{{ entry.presenter }}{% endif %}</div>
        <div class="ledger-place">{% if entry.venue %}{{ entry.venue }}{% if entry.city %}<br>{% endif %}{% endif %}{{ entry.city }}{% if entry.region %}, {{ entry.region }}{% endif %}{% if entry.note %}<br><span class="note">{{ entry.note }}</span>{% endif %}</div>
      </li>
    {% if loop.last %}</ol>{% endif %}
  {% endfor %}
</div>
